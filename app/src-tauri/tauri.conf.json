{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tween",
  "version": "0.1.0",
  "identifier": "app.tween.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tween",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 700,
        "decorations": false,
        "backgroundColor": "#0b0b0b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "THIRD_PARTY_NOTICES.md"
    ],
    "shortDescription": "AI video frame interpolator powered by RIFE",
    "category": "Video",
    "copyright": "Copyright (c) 2026 Adarsh Pathade",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "dmg": {}
    },
    "linux": {
      "deb": {},
      "appimage": {}
    }
  }
}
